# ============================================================
# MV ProShoot — .gitignore
# ============================================================

# --- Environment variables (NEVER commit these) ---
.env
.env.*
*.env
**/.env
**/.env.*
server/.env
client/.env

# --- Node Dependencies ---
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Build outputs ---
dist/
**/dist/
build/
.next/
out/

# --- Editor & OS ---
.DS_Store
Thumbs.db
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln

# --- Logs ---
logs/
*.log

# --- Cache ---
.cache/
.eslintcache
